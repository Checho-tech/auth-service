# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file — it is already excluded in .gitignore.

# --- App ---
APP_NAME="Authentication Service"
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- Database ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://auth_user:changeme@localhost:5432/auth_service_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=auth_service_db

# --- JWT (RS256: asymmetric keys, not a shared secret) ---
# Generate your own key pair (never commit these — see .gitignore):
#   mkdir -p keys
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
# The public key is also served at GET /.well-known/jwks.json for other
# services (e.g. Inventory Service) to verify tokens without ever holding
# a copy of the private key or a shared secret.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Account lockout policy ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# --- Rate limiting ---
RATE_LIMIT_LOGIN="5/minute"

# --- CORS (comma-separated origins allowed to call this API from a browser) ---
CORS_ORIGINS=http://localhost:5173

# --- Mock SMTP (for email verification / password reset) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@auth-service.local
