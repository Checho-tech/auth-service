# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file — it is already excluded in .gitignore.

# --- App ---
APP_NAME="Authentication Service"
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- Database ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://auth_user:changeme@localhost:5432/auth_service_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=auth_service_db

# --- JWT ---
# Generate a strong random secret, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this value across environments (dev/staging/prod each need their own).
JWT_SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Account lockout policy ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# --- Rate limiting ---
RATE_LIMIT_LOGIN="5/minute"

# --- Mock SMTP (for email verification / password reset) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@auth-service.local
